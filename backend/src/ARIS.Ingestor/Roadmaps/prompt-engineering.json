      }
    },
    {
      "id": "-tQ7Cn4fHAfGmDkUb9bMb",
      "type": "label",
      "data": {
        "label": "\u2014 Provide few-shot examples for structure or  output style you need"
      }
    },
    {
      "id": "xaAeeGwAPdo4dGyIqDDgV",
      "type": "label",
      "data": {
        "label": "\u2014  Keep your prompts short and concise"
      }
    },
    {
      "id": "31XQlT6NkkT20sAX-TkVm",
      "type": "label",
      "data": {
        "label": "\u2014 Prioritize giving clearer instructions over adding constraints"
      }
    },
    {
      "id": "y9iXqGBteGkVcgvxPBb0s",
      "type": "label",
      "data": {
        "label": "\u2014 Control the maximum output length"
      }
    },
    {
      "id": "tr7dmZpkguAJUmnpK_JLi",
      "type": "label",
      "data": {
        "label": "\u2014 Use variables / placeholders in your prompts for easier configuration"
      }
    },
    {
      "id": "UGhqnEUD6RnDTPIMeU16Y",
      "type": "label",
      "data": {
        "label": "\u2014 Experiment with input formats and writing styles"
      }
    },
    {
      "id": "iQycTLfHB2I21lZKt08YR",
      "type": "label",
      "data": {
        "label": "\u2014 Tune sampling (temperature, top-k, top-p) for determinism vs creativity"
      }
    },
    {
      "id": "qg7-CD2SVsU1bvFWZJ3Zn",
      "type": "label",
      "data": {
        "label": "\u2014 Guard against prompt injection; sanitize user text"
      }
    },
    {
      "id": "M71WrxOxArDF1lgM6WJgW",
      "type": "label",
      "data": {
        "label": "\u2014 Automate evaluation; integrate unit tests for outputs"
      }
    },
    {
      "id": "BX6MXjBAjBj0ql2N-HM3b",
      "type": "label",
      "data": {
        "label": "\u2014 Document and track prompt versions"
      }
    },
    {
      "id": "T5quDRbzzWXeEnT-F09WG",
      "type": "label",
      "data": {
        "label": "\u2014 Optimize for latency \u0026 cost in production pipelines"
      }
    },
    {
      "id": "vIgk7Kc2mKigvE9PWcuX5",
      "type": "label",
      "data": {
        "label": "\u2014 Document decisions, failures, and learnings for future devs"
      }
    },
    {
      "id": "jb0pTPfNUwEzlT1uAXCGx",
      "type": "label",
      "data": {
        "label": "\u2014 Delimit different sections with triple backticks or XML tags"
      }
    },
    {
      "id": "7RBX-apLraCu-jURtrKfp",
      "type": "label",
      "data": {
        "label": "\u2014  Ask for structured output if it helps e.g. JSON, XML, Markdown, CSV etc"
      }
    },
